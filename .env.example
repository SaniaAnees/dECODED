# Project-local keys (lowest priority).
# Preferred: `decoded set-key groq <key>` writes ~/.decodedd/.env
# Cursor / Claude Code can also send Authorization / x-api-key on each request.

GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# groq | openrouter | auto
PROXY_PROVIDER=auto
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
DEFAULT_MODEL=
PROXY_TARGET=
