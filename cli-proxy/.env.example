# Local keys — copy to .env (gitignored) and fill in values.

# 1. Google Gemini API (Context Caching & Multimodal)
GEMINI_API_KEY=

# 2. Groq Cloud (Ultra-Fast Free Llama 3.3 70B & DeepSeek R1)
GROQ_API_KEY=

# 3. OpenRouter (20+ Free Open-Weights Models ending in :free)
OPENROUTER_API_KEY=

# 4. Mistral AI (Codestral Coding Model & Mistral Small)
MISTRAL_API_KEY=

# groq | openrouter | auto (Groq first, OpenRouter for :free models and fallback)
PROXY_PROVIDER=auto
PROXY_HOST=127.0.0.1
PROXY_PORT=8080

# Optional overrides. Leave blank to use the provider default.
DEFAULT_MODEL=
PROXY_TARGET=

TELEMETRY_DB=telemetry.db
