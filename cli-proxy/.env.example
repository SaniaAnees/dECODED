# decodedd local proxy — keys stay on this machine.
# Copy to .env and fill in values.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Bind address. Keep 127.0.0.1 so the daemon is localhost-only.
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_TARGET=https://api.anthropic.com

# Inject Anthropic cache_control breakpoints on tools + system when missing.
AUTO_CACHE_CONTROL=true

# SQLite file (relative to this directory unless absolute).
TELEMETRY_DB=telemetry.db
