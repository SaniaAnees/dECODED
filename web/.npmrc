# next-auth@4 declares nodemailer as an *optional* peer (it only needs it for
# its email sign-in provider, which this app does not use) and pins it to ^7.
# That line of nodemailer carries a critical and five high advisories, so we run
# nodemailer 10 instead. Without this, `npm install` aborts with ERESOLVE and
# the deployment fails to build.
legacy-peer-deps=true
