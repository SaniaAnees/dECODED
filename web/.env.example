# =============================================================================
# LOCAL DEV ONLY — copy to .env.local and fill secrets. Never commit .env.local.
# Production usecoded.com URLs → set on Vercel (see PRODUCTION section below).
# =============================================================================

DATABASE_URL=

AUTH_SECRET=
AUTH_USE_DATABASE=true

# --- Local site URLs (register OAuth callbacks in Google/GitHub dashboards) ---
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/sign-in
NEXT_PUBLIC_PROXY_URL=http://proxy.localhost:3000

# Google OAuth — register these EXACT URIs in Google Cloud Console:
#   Redirect:  http://localhost:3000/api/auth/callback/google
#   JS origin: http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth — https://github.com/settings/developers → OAuth Apps
#   Callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Feedback form (/feedback) — Resend → owner inboxes
# Create API key + verified from-domain at https://resend.com
RESEND_API_KEY=
# One address, or several separated by commas. All of them receive feedback.
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Fallback transport: the mailbox on our own domain, which can send anywhere.
# Used for any recipient Resend is not permitted to reach.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when empty.
SMTP_FROM=

# Razorpay Pro checkout (server secrets — never NEXT_PUBLIC for secret/webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# =============================================================================
# PRODUCTION — usecoded.com (Vercel → Settings → Environment Variables ONLY)
# Do NOT uncomment these in .env.local while running npm run dev
# =============================================================================
#
# NEXTAUTH_URL=https://auth.usecoded.com
# AUTH_COOKIE_DOMAIN=.usecoded.com
# NEXT_PUBLIC_SITE_URL=https://usecoded.com
# NEXT_PUBLIC_AUTH_URL=https://auth.usecoded.com
# NEXT_PUBLIC_PROXY_URL=https://proxy.usecoded.com
#
# Google redirect (prod): https://auth.usecoded.com/api/auth/callback/google
# Google JS origins:    https://usecoded.com  https://auth.usecoded.com
# GitHub callback (prod): https://auth.usecoded.com/api/auth/callback/github
#
# Vercel domains: usecoded.com, www.usecoded.com, auth.usecoded.com, proxy.usecoded.com
# Razorpay webhook (prod): https://usecoded.com/api/razorpay/webhook
