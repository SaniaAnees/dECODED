# =============================================================================
# LOCAL DEV ONLY — copy to .env.local and fill secrets. Never commit .env.local.
# Production wrayle.com URLs → set on Vercel (see PRODUCTION section below).
# =============================================================================

DATABASE_URL=

AUTH_SECRET=
AUTH_USE_DATABASE=true

# --- Local site URLs (register OAuth callbacks in Google/GitHub dashboards) ---
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/sign-in
NEXT_PUBLIC_PROXY_URL=http://proxy.localhost:3000

# Google OAuth — register these EXACT URIs in Google Cloud Console:
#   Redirect:  http://localhost:3000/api/auth/callback/google
#   JS origin: http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth — https://github.com/settings/developers → OAuth Apps
#   Callback:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Feedback form (/feedback) — Resend → owner inbox
# Create API key + verified from-domain at https://resend.com
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Razorpay Pro checkout (server secrets — never NEXT_PUBLIC for secret/webhook)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# =============================================================================
# PRODUCTION — wrayle.com (Vercel → Settings → Environment Variables ONLY)
# Do NOT uncomment these in .env.local while running npm run dev
# =============================================================================
#
# NEXTAUTH_URL=https://auth.wrayle.com
# AUTH_COOKIE_DOMAIN=.wrayle.com
# NEXT_PUBLIC_SITE_URL=https://wrayle.com
# NEXT_PUBLIC_AUTH_URL=https://auth.wrayle.com
# NEXT_PUBLIC_PROXY_URL=https://proxy.wrayle.com
#
# Google redirect (prod): https://auth.wrayle.com/api/auth/callback/google
# Google JS origins:    https://wrayle.com  https://auth.wrayle.com
# GitHub callback (prod): https://auth.wrayle.com/api/auth/callback/github
#
# Vercel domains: wrayle.com, www.wrayle.com, auth.wrayle.com, proxy.wrayle.com
# Razorpay webhook (prod): https://wrayle.com/api/razorpay/webhook
